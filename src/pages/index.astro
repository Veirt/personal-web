---
import GitHubActivity from "../components/GitHubActivity.astro";
import ElsewhereTile from "../components/ElsewhereTile.astro";
import HomeIdentity from "../components/HomeIdentity.astro";
import LatelyTile from "../components/LatelyTile.astro";
import NowListening from "../components/NowListening.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const topTileSize = "min-h-56";
const bottomTileSize = "min-h-48 max-sm:min-h-52";
---

<SiteLayout
	title="Home"
	description="I make small tools, explore odd ideas, and share software side quests from my corner of the web."
	active="home"
>
	<div class="home-page">
		<section class="mb-12 grid gap-3" aria-label="A few things about me">
			<div class="grid grid-cols-[1.1fr_0.95fr] gap-3 max-sm:grid-cols-1">
				<HomeIdentity className={topTileSize} />
				<NowListening className={topTileSize} />
			</div>
			<div class="grid grid-cols-5 gap-3 max-sm:grid-cols-1">
				<LatelyTile className={`col-span-2 max-sm:col-span-1 ${bottomTileSize}`} />
				<ElsewhereTile className={`col-span-3 max-sm:col-span-1 ${bottomTileSize}`} />
			</div>
		</section>
		<GitHubActivity />
	</div>
</SiteLayout>
