---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Lost" description="This little page wandered off somewhere." noIndex>
	<section class="flex min-h-[60vh] flex-col items-start justify-center">
		<h1 class="mb-8 text-5xl leading-none font-extrabold tracking-tighter md:text-6xl">
			<span>404</span>
			<br />
			<em class="text-accent not-italic">Nothing here.</em>
		</h1>
		<a
			class="inline-flex items-center gap-4 rounded-full bg-ink px-4 py-3 text-sm font-semibold text-paper transition hover:-translate-y-0.5 hover:bg-accent-strong hover:text-white"
			href="/"
		>
			Head back home{" "}
			<span class="text-base text-white" aria-hidden="true">
				↗
			</span>
		</a>
	</section>
</SiteLayout>
