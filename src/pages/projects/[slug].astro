---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projects = (await getCollection("projects")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const currentIndex = projects.findIndex((item) => item.id === project.id);
const previousProject = projects[currentIndex - 1];
const nextProject = projects[currentIndex + 1];
const hasBody = Boolean(project.body?.trim());
---

<SiteLayout
	title={project.data.title}
	description={project.data.description}
	active="projects"
	type="article"
>
	<article class="mx-auto max-w-5xl">
		<div class="mb-5 flex items-center justify-between gap-4">
			<a
				class="inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-accent-strong"
				href="/projects/"
			>
				← <span>project shelf</span>
			</a>
		</div>

		<header class="grid min-h-112 grid-cols-5 items-stretch gap-5 max-lg:min-h-0 max-lg:grid-cols-1 max-lg:gap-0">
			<div class="project-hero__copy relative col-span-2 flex min-w-0 -rotate-1 flex-col items-start justify-center overflow-hidden rounded-3xl border border-line/75 bg-surface-raised p-8 shadow-md max-lg:col-span-1 max-lg:mr-auto max-lg:min-h-68 max-lg:w-11/12 max-lg:p-7 max-sm:w-full max-sm:p-5">
				<h1 class="relative z-10 m-0 max-w-full text-5xl leading-none font-extrabold tracking-tighter break-words md:text-6xl">
					{project.data.title}
				</h1>
				<p class="relative z-10 mt-4 mb-5 max-w-md text-base leading-relaxed text-muted max-sm:my-4 max-sm:text-sm">
					{project.data.description}
				</p>
				<div
					class="project-hero__tags relative z-10 flex flex-wrap gap-2"
					aria-label="Technologies"
				>
					{project.data.technologies.map((technology) => (
						<span class="rounded-full border border-line/75 bg-paper-deep px-3 py-1 font-mono text-xs text-muted">
							{technology}
						</span>
					))}
				</div>
				{project.data.github_url && (
					<a
						class="relative z-10 mt-6 inline-flex items-center gap-4 rounded-xl border border-line/75 bg-ink px-4 py-3 text-sm font-bold text-paper transition hover:-translate-y-0.5"
						href={project.data.github_url}
						target="_blank"
						rel="noreferrer"
					>
						<span>Take a closer look</span>
						<span aria-hidden="true">↗</span>
					</a>
				)}
			</div>

			<figure
				class:list={[
					"project-hero__visual relative z-0 col-span-3 mt-3 ml-auto grid min-h-96 w-11/12 min-w-0 rotate-1 place-items-center overflow-hidden rounded-3xl border border-line/75 bg-paper-deep p-5 pb-10 shadow-md max-lg:z-10 max-lg:col-span-1 max-lg:-mt-2 max-lg:min-h-80 max-sm:mt-3 max-sm:min-h-64 max-sm:w-full max-sm:p-3",
					!project.data.screenshot && "project-hero__visual--icon bg-surface-raised",
				]}
			>
				{project.data.screenshot ? (
					<img
						class="relative z-10 size-full max-h-88 rounded-xl object-contain shadow-lg grayscale max-md:max-h-72 max-sm:max-h-56"
						src={project.data.screenshot}
						alt={`${project.data.title} in use`}
						fetchpriority="high"
					/>
				) : (
					<img
						class="relative z-10 h-auto w-52 rounded-3xl shadow-xl grayscale"
						src={project.data.icon ?? "/assets/project-icon-placeholder.svg"}
						alt=""
						fetchpriority="high"
					/>
				)}
			</figure>
		</header>

		{hasBody && (
			<section
				class="mx-auto mt-12 max-w-3xl border-t border-line/75 px-4 pt-6 max-sm:mt-8 max-sm:px-2 max-sm:pt-4"
				aria-label={`About ${project.data.title}`}
			>
				<div class="markdown-content">
					<Content />
				</div>
			</section>
		)}

		<nav
			class="my-12 grid grid-cols-[1fr_auto_1fr] items-center gap-4 border-y border-line/75 py-4 max-sm:mt-9 max-sm:gap-2"
			aria-label="More projects"
		>
			{previousProject ? (
				<a
					class="flex min-w-0 flex-col gap-1 text-sm hover:text-accent-strong"
					href={`/projects/${previousProject.id}/`}
				>
					<strong class="max-w-40 truncate">← {previousProject.data.title}</strong>
				</a>
			) : (
				<span></span>
			)}
			<a
				class="rounded-full border border-line/75 px-3 py-2 text-xs whitespace-nowrap text-muted hover:text-accent-strong"
				href="/projects/"
			>
				All projects <span aria-hidden="true">↗</span>
			</a>
			{nextProject ? (
				<a
					class="flex min-w-0 flex-col gap-1 text-right text-sm hover:text-accent-strong"
					href={`/projects/${nextProject.id}/`}
				>
					<strong class="max-w-40 truncate">{nextProject.data.title} →</strong>
				</a>
			) : (
				<span></span>
			)}
		</nav>
	</article>
</SiteLayout>
