---
import { getCollection, render } from "astro:content";
import Breadcrumb from "../../components/Breadcrumb.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projects = (await getCollection("projects")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const currentIndex = projects.findIndex((item) => item.id === project.id);
const previousProject = projects[currentIndex - 1];
const nextProject = projects[currentIndex + 1];
const hasBody = Boolean(project.body?.trim());
---

<SiteLayout
	title={project.data.title}
	description={project.data.description}
	active="projects"
	type="article"
>
	<article class="mx-auto max-w-5xl">
		<Breadcrumb href="/projects/" label="all projects" />
		<header class="project-detail-header relative isolate mb-6 overflow-hidden">
			<img
				class="project-topo-map pointer-events-none absolute top-0 right-0 -z-10 w-3/5 opacity-30 max-md:w-4/5"
				src="/assets/topo-map.svg"
				alt=""
				aria-hidden="true"
				decoding="async"
			/>
			<div class="relative mt-3 flex items-end justify-between gap-6 max-sm:mt-3 max-sm:flex-col max-sm:items-start">
				<div class="min-w-0">
					<h1 class="m-0 flex items-center gap-3 text-6xl leading-none font-extrabold tracking-tighter break-words max-sm:text-5xl">
						{project.data.title}
						<span class="size-3 shrink-0 rounded-sm bg-accent" aria-hidden="true"></span>
					</h1>
					<p class="mt-4 mb-0 text-sm leading-relaxed text-muted sm:text-base">
						{project.data.description}
					</p>
				</div>
				<div class="flex shrink-0 items-center gap-3 font-mono text-xs text-muted">
					<span>{project.data.date.getFullYear()}</span>
					{project.data.github_url && (
						<a
							class="inline-flex items-center gap-1.5 transition-colors hover:text-accent-strong"
							href={project.data.github_url}
							target="_blank"
							rel="noreferrer"
						>
							source <span aria-hidden="true">↗</span>
						</a>
					)}
				</div>
			</div>
		</header>

		<figure
			class:list={[
				"w-full min-w-0 overflow-hidden rounded-2xl border border-line bg-paper-deep p-4 max-sm:p-3",
				!project.data.screenshot && "grid min-h-72 place-items-center",
			]}
		>
			{project.data.screenshot ? (
				<img
					class="relative z-10 block h-auto w-full rounded-lg object-contain"
					src={project.data.screenshot}
					alt={`${project.data.title} in use`}
					fetchpriority="high"
				/>
			) : (
				<img
					class="relative z-10 h-auto w-52"
					src={project.data.icon ?? "/assets/project-icon-placeholder.svg"}
					alt=""
					fetchpriority="high"
				/>
			)}
		</figure>

		<div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
			<h2 class="m-0 font-mono text-xs font-medium tracking-wider text-muted uppercase">
				Built with
			</h2>
			<div class="flex flex-wrap gap-2" aria-label="Technologies">
				{project.data.technologies.map((technology) => (
					<span class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted">
						{technology}
					</span>
				))}
			</div>
		</div>

		{hasBody && (
			<section class="markdown-content mt-10 w-full" aria-label={`About ${project.data.title}`}>
				<Content />
			</section>
		)}

		<nav
			class="my-12 grid grid-cols-[1fr_auto_1fr] items-center gap-4 border-y border-line/75 py-4 max-sm:mt-9 max-sm:gap-2"
			aria-label="More projects"
		>
			{previousProject ? (
				<a
					class="flex min-w-0 flex-col gap-1 text-sm hover:text-accent-strong"
					href={`/projects/${previousProject.id}/`}
				>
					<strong class="max-w-40 truncate">← {previousProject.data.title}</strong>
				</a>
			) : (
				<span></span>
			)}
			<a
				class="rounded-full border border-line/75 px-3 py-2 text-xs whitespace-nowrap text-muted hover:text-accent-strong"
				href="/projects/"
			>
				All projects <span aria-hidden="true">↗</span>
			</a>
			{nextProject ? (
				<a
					class="flex min-w-0 flex-col gap-1 text-right text-sm hover:text-accent-strong"
					href={`/projects/${nextProject.id}/`}
				>
					<strong class="max-w-40 truncate">{nextProject.data.title} →</strong>
				</a>
			) : (
				<span></span>
			)}
		</nav>
	</article>
</SiteLayout>
