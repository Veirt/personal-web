<github-activity
	class="relative block min-h-48 min-w-0 overflow-hidden rounded-3xl border border-line bg-paper-deep p-5 max-sm:p-4"
	aria-labelledby="activity-title"
	role="region"
>
	<div class="relative z-10 mb-4 flex min-h-7 items-center">
		<h2 class="m-0 text-xl leading-tight font-extrabold tracking-tight" id="activity-title">
			GitHub Contributions
		</h2>
	</div>
	<svg
		class="pointer-events-none absolute top-2 right-4 hidden h-20 w-36 text-muted opacity-70 md:block"
		viewBox="0 0 180 80"
		fill="none"
		aria-hidden="true"
	>
		<g stroke="currentColor" stroke-linecap="round">
			<ellipse
				cx="94"
				cy="41"
				rx="74"
				ry="24"
				transform="rotate(-10 94 41)"
				stroke-opacity="0.45"
				stroke-width="0.8"
			/>
			<ellipse
				cx="94"
				cy="41"
				rx="61"
				ry="18"
				transform="rotate(-4 94 41)"
				stroke-opacity="0.3"
				stroke-width="0.7"
			/>
			<ellipse
				cx="94"
				cy="41"
				rx="45"
				ry="12"
				transform="rotate(-16 94 41)"
				stroke-opacity="0.25"
				stroke-width="0.7"
			/>
			<path d="M8 62c24-12 48-14 72-6s48 8 72-4" stroke-opacity="0.2" stroke-width="0.7" />
			<path d="M18 10v6m-3-3h6" stroke-opacity="0.4" stroke-width="0.8" />
		</g>
		<g fill="currentColor">
			<circle cx="34" cy="24" r="1.2" fill-opacity="0.5" />
			<circle cx="146" cy="18" r="1" fill-opacity="0.4" />
			<circle cx="158" cy="58" r="1.4" fill-opacity="0.45" />
			<circle cx="64" cy="65" r="1" fill-opacity="0.35" />
			<circle cx="112" cy="13" r="1.1" fill-opacity="0.4" />
		</g>
		<circle cx="146" cy="18" r="3.2" fill="var(--accent)" fill-opacity="0.8" />
		<path d="M34 24l2.2 2.2L34 28.4l-2.2-2.2z" fill="var(--accent)" fill-opacity="0.7" />
	</svg>

	<div class="relative z-10 min-w-0">
		<p class="my-3 text-sm text-muted" data-contribution-status aria-live="polite">
			Loading contribution activity…
		</p>
		<div class="w-full overflow-x-auto" data-contribution-calendar hidden>
			<div class="flex min-w-max gap-[3px]" data-contribution-weeks role="img"></div>
		</div>
		<p class="mt-3 text-sm leading-snug text-muted">Code, experiments &amp; other bits</p>
	</div>
</github-activity>

<script>
	import { calendarLayout, CONTRIBUTION_LEVEL_CLASSES, type ContributionDay } from "../lib/github";

	type ContributionResponse = {
		total?: { lastYear?: number };
		contributions: ContributionDay[];
	};

	type CachedActivity = {
		storedAt: number;
		payload: ContributionResponse;
	};

	const CACHE_KEY = "github-activity:v1";
	const CACHE_TTL = 60 * 60 * 1000;

	const dateFormat = new Intl.DateTimeFormat("en", {
		month: "short",
		day: "numeric",
		year: "numeric",
		timeZone: "UTC",
	});

	function createDayCell(day: ContributionDay | null) {
		const cell = document.createElement("span");
		if (day) {
			cell.className = `block size-2 rounded-sm max-sm:size-1.5 ${CONTRIBUTION_LEVEL_CLASSES[day.level] ?? CONTRIBUTION_LEVEL_CLASSES[0]}`;
			cell.title = `${day.count} contribution${day.count === 1 ? "" : "s"} on ${dateFormat.format(new Date(`${day.date}T00:00:00Z`))}`;
		} else {
			cell.className = "block size-2 rounded-sm bg-transparent max-sm:size-1.5";
		}
		return cell;
	}

	function readCache(): CachedActivity | null {
		try {
			const raw = localStorage.getItem(CACHE_KEY);
			if (!raw) return null;

			const cached = JSON.parse(raw) as CachedActivity;
			if (
				typeof cached?.storedAt !== "number" ||
				!Array.isArray(cached.payload?.contributions) ||
				cached.payload.contributions.length === 0
			) {
				return null;
			}

			return cached;
		} catch {
			return null;
		}
	}

	function writeCache(payload: ContributionResponse) {
		try {
			localStorage.setItem(CACHE_KEY, JSON.stringify({ storedAt: Date.now(), payload }));
		} catch {}
	}

	class GitHubActivity extends HTMLElement {
		private controller?: AbortController;

		connectedCallback() {
			void this.load();
		}

		disconnectedCallback() {
			this.controller?.abort();
		}

		private render(payload: ContributionResponse) {
			const status = this.querySelector<HTMLElement>("[data-contribution-status]")!;
			const calendar = this.querySelector<HTMLElement>("[data-contribution-calendar]")!;
			const weekColumns = this.querySelector<HTMLElement>("[data-contribution-weeks]")!;

			const layout = calendarLayout(payload.contributions);
			const count =
				payload.total?.lastYear ?? payload.contributions.reduce((sum, day) => sum + day.count, 0);

			weekColumns.replaceChildren();
			weekColumns.setAttribute(
				"aria-label",
				`${count.toLocaleString("en")} contributions over the past year`,
			);
			for (const week of layout.weeks) {
				const column = document.createElement("div");
				column.className = "grid grid-rows-7 gap-[3px] max-sm:gap-[2px]";
				column.append(...week.days.map(createDayCell));
				weekColumns.append(column);
			}

			calendar.hidden = false;
			status.hidden = true;
		}

		private async load() {
			const status = this.querySelector<HTMLElement>("[data-contribution-status]")!;
			const cached = readCache();

			if (cached) {
				this.render(cached.payload);
				if (Date.now() - cached.storedAt < CACHE_TTL) return;
			}

			const controller = new AbortController();
			this.controller = controller;
			const timeout = window.setTimeout(() => controller.abort(), 8000);

			try {
				const endpoint = new URL("https://github-contributions-api.jogruber.de/v4/Veirt");
				endpoint.searchParams.set("y", "last");

				const response = await fetch(endpoint, {
					headers: { Accept: "application/json" },
					signal: controller.signal,
				});
				if (!response.ok) throw new Error(`GitHub activity returned ${response.status}`);

				const payload = (await response.json()) as ContributionResponse;
				if (!payload.contributions.length) throw new Error("No activity days returned");

				writeCache(payload);
				this.render(payload);
			} catch {
				if (!this.isConnected || cached) return;
				status.textContent = "Contribution activity is unavailable right now.";
			} finally {
				window.clearTimeout(timeout);
			}
		}
	}

	if (!customElements.get("github-activity")) {
		customElements.define("github-activity", GitHubActivity);
	}
</script>
