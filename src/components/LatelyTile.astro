---
interface Props {
	className?: string;
}

const { className } = Astro.props;
---

<a
	class={`relative flex min-w-0 flex-col items-start overflow-hidden rounded-3xl border border-line bg-ink p-5 pt-12 text-paper max-sm:p-4 max-sm:pt-12 ${className ?? ""}`}
	href="/blog/"
>
	<svg
		class="absolute top-3 right-5 w-1/2 text-paper/70"
		viewBox="0 0 190 34"
		fill="none"
		aria-hidden="true"
	>
		<path
			d="M2 4 182 7M8 12l145 3M0 20l168 3M12 28l118 2"
			stroke="currentColor"
			stroke-width="3"
			stroke-linecap="round"
		/>
	</svg>
	<span class="relative z-10 mt-auto mb-3 max-w-72 text-sm leading-snug font-semibold">
		Tinkering with this little corner of the internet.
	</span>
	<span class="relative z-10 text-5xl leading-none font-extrabold tracking-tighter max-sm:text-4xl">
		WRITINGS
	</span>
	<svg class="absolute right-5 bottom-5 size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
		<path
			d="M3 13 13 3M5 3h8v8"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"
		/>
	</svg>
</a>
