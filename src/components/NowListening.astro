---
const username = import.meta.env.PUBLIC_LASTFM_USERNAME ?? "veirt";
const apiKey = import.meta.env.PUBLIC_LASTFM_API_KEY ?? "";
const waveformBars = [35, 70, 49, 92, 58, 27, 78, 43, 100, 55, 33, 82, 46, 68, 29, 88, 51];
const params = new URLSearchParams({
	method: "user.getRecentTracks",
	user: username,
	api_key: apiKey,
	format: "json",
	limit: "1",
});
const endpoint = apiKey ? `https://ws.audioscrobbler.com/2.0/?${params}` : null;
interface Props {
	className?: string;
}

const { className } = Astro.props;
---

<now-playing
	class={`home-tile--listening relative flex min-w-0 flex-col justify-between overflow-hidden rounded-3xl border border-line bg-ink p-5 text-paper max-sm:p-4 ${className ?? ""}`}
	data-endpoint={endpoint ?? undefined}
	aria-live="polite"
	aria-atomic="true"
	role="article"
>
	<div class="relative z-10 mb-1 grid min-h-24 grid-cols-5 items-center gap-4">
		<div
			class="listening-waveform col-span-2 flex h-14 w-full items-center justify-between gap-1"
			aria-hidden="true"
		>
			{waveformBars.map((height) => (
				<i style={`--bar-height: ${height}%;`} />
			))}
		</div>
		<div class="relative z-10 col-span-3 min-w-0 text-paper">
			<h3
				class="m-0 text-lg leading-tight font-bold tracking-tight max-lg:text-base max-sm:text-lg"
				data-lastfm-track
				hidden
			></h3>
			<p class="mt-1 text-sm text-paper/80" data-lastfm-artist hidden></p>
			<p class="mt-1 block text-xs text-paper/70" data-lastfm-time hidden></p>
		</div>
	</div>
	<div class="relative z-10 flex items-end justify-between gap-3">
		<h2 class="m-0 text-6xl leading-none font-extrabold tracking-tighter max-sm:text-5xl">NOW</h2>
		<div class="max-w-28 text-right">
			<p class="mt-2 font-mono text-[0.625rem] text-paper/70">
				Powered by{" "}
				<a
					class="underline underline-offset-2 hover:text-paper"
					href="https://www.last.fm/"
					target="_blank"
					rel="noreferrer"
				>
					AudioScrobbler
				</a>
			</p>
		</div>
	</div>
</now-playing>

<script>
	type LastFmTrack = {
		name: string;
		artist: string | { "#text": string };
		date?: { uts: string };
		"@attr"?: { nowplaying?: "true" };
	};

	type LastFmResponse = {
		error?: number;
		message?: string;
		recenttracks?: { track?: LastFmTrack | LastFmTrack[] };
	};

	const playedAtFormat = new Intl.DateTimeFormat(undefined, {
		dateStyle: "medium",
		timeStyle: "short",
	});

	class NowPlaying extends HTMLElement {
		private controller?: AbortController;

		connectedCallback() {
			void this.load();
		}

		disconnectedCallback() {
			this.controller?.abort();
		}

		private async load() {
			const endpoint = this.dataset.endpoint;
			if (!endpoint) return;

			const title = this.querySelector<HTMLElement>("[data-lastfm-track]")!;
			const artist = this.querySelector<HTMLElement>("[data-lastfm-artist]")!;
			const time = this.querySelector<HTMLElement>("[data-lastfm-time]")!;

			const controller = new AbortController();
			this.controller = controller;
			const timeout = window.setTimeout(() => controller.abort(), 8000);

			try {
				const response = await fetch(endpoint, {
					signal: controller.signal,
					headers: { Accept: "application/json" },
				});
				if (!response.ok) throw new Error(`Last.fm returned ${response.status}`);

				const payload = (await response.json()) as LastFmResponse;
				if (payload.error) throw new Error(payload.message ?? "Last.fm request failed");

				const tracks = payload.recenttracks?.track;
				const track = Array.isArray(tracks) ? tracks[0] : tracks;
				if (!track) {
					title.hidden = true;
					artist.hidden = true;
					time.hidden = true;
					return;
				}

				const isPlaying = track["@attr"]?.nowplaying === "true";
				const artistName = typeof track.artist === "string" ? track.artist : track.artist["#text"];
				const playedAt = track.date?.uts ? new Date(Number(track.date.uts) * 1000) : null;

				this.classList.toggle("is-playing", isPlaying);
				title.textContent = track.name;
				title.hidden = false;
				artist.textContent = artistName;
				artist.hidden = false;
				time.textContent = isPlaying
					? "playing right now"
					: playedAt
						? playedAtFormat.format(playedAt)
						: "";
				time.hidden = !time.textContent;
			} catch {
				if (!this.isConnected) return;
				title.hidden = true;
				artist.hidden = true;
				time.hidden = true;
			} finally {
				window.clearTimeout(timeout);
			}
		}
	}

	if (!customElements.get("now-playing")) {
		customElements.define("now-playing", NowPlaying);
	}
</script>
