---
interface Props {
	className?: string;
}

const { className } = Astro.props;
const lastFmUsername = import.meta.env.PUBLIC_LASTFM_USERNAME ?? "veirt";
const lastFmProfileUrl = `https://www.last.fm/user/${encodeURIComponent(lastFmUsername)}`;
const linkClass =
	"flex items-center gap-1 rounded-xl border border-line bg-paper-deep px-2 py-2 shadow-sm -rotate-2 transition hover:rotate-0 hover:-translate-y-0.5 hover:shadow-md";
const iconClass = "size-4 shrink-0 text-muted opacity-80";
const labelClass = "text-xs font-bold tracking-tight";
const externalClass = "size-4 shrink-0 text-muted elsewhere-link__external";
---

<article
	class={`relative flex min-w-0 flex-col items-start overflow-hidden rounded-3xl border border-line bg-surface-muted p-5 shadow-md max-sm:p-4 ${className ?? ""}`}
>
	<div class="order-1 mb-3 flex w-full items-center justify-between">
		<h2 class="m-0 origin-left -rotate-1 text-lg font-extrabold tracking-tight">Elsewhere</h2>
	</div>
	<div class="relative order-2 flex min-h-28 w-full flex-col items-start">
		<p class="relative z-10 order-2 mt-2 text-sm leading-snug text-muted">
			Code, experiments &amp; other bits
		</p>
		<div class="relative z-10 order-1 flex w-full min-w-0 flex-wrap items-start gap-2">
			<a class={linkClass} href="https://github.com/Veirt" target="_blank" rel="me noreferrer">
				<svg
					class={`${iconClass} elsewhere-link__icon--github`}
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path d="M12 .297a12 12 0 0 0-3.797 23.382c.6.11.82-.26.82-.577v-2.234c-3.338.726-4.043-1.416-4.043-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.084 1.84 1.237 1.84 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.323 3.3 1.23a11.5 11.5 0 0 1 6 0c2.292-1.553 3.297-1.23 3.297-1.23.655 1.652.243 2.873.12 3.176.77.84 1.235 1.911 1.235 3.22 0 4.61-2.803 5.625-5.475 5.92.43.372.823 1.102.823 2.222v3.293c0 .32.216.694.825.576A12.003 12.003 0 0 0 12 .297" />
				</svg>
				<span class={labelClass}>GitHub</span>
				<svg class={externalClass} viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M9 2h5v5M14 2 7 9" />
					<path d="M12 9v4a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h4" />
				</svg>
			</a>
			<a class={linkClass} href={lastFmProfileUrl} target="_blank" rel="me noreferrer">
				<svg
					class={`${iconClass} elsewhere-link__icon--lastfm`}
					viewBox="0 0 24 24"
					fill="none"
					aria-hidden="true"
				>
					<path d="M3.5 13h3l2.1-5.5 3.1 9 2.6-7 1.8 3.5h4.4" />
				</svg>
				<span class={labelClass}>Last.fm</span>
				<svg class={externalClass} viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M9 2h5v5M14 2 7 9" />
					<path d="M12 9v4a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h4" />
				</svg>
			</a>
			<a class={linkClass} href="mailto:veirt@duck.com">
				<svg
					class={`${iconClass} elsewhere-link__icon--email`}
					viewBox="0 0 24 24"
					fill="none"
					aria-hidden="true"
				>
					<rect x="3" y="5" width="18" height="14" rx="4" />
					<path d="m5 8 7 5 7-5" />
				</svg>
				<span class={labelClass}>Email</span>
				<svg class={externalClass} viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M9 2h5v5M14 2 7 9" />
					<path d="M12 9v4a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h4" />
				</svg>
			</a>
		</div>
		<span
			class="pointer-events-none absolute -right-1 -bottom-12 z-0 -rotate-12 font-serif text-9xl leading-none text-ink/20 select-none"
			aria-hidden="true"
		>
			~
		</span>
	</div>
</article>
