---
interface Props {
	className?: string;
}

const { className } = Astro.props;
const lastFmUsername = import.meta.env.PUBLIC_LASTFM_USERNAME ?? "veirt";
const lastFmProfileUrl = `https://www.last.fm/user/${encodeURIComponent(lastFmUsername)}`;
const linkClass =
	"flex items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-ink transition-colors hover:bg-paper-deep";
const iconClass = "size-4 shrink-0 text-muted opacity-80";
const labelClass = "text-xs font-bold tracking-tight";
const externalClass = "size-3.5 shrink-0 text-muted elsewhere-link__external";
---

<article
	class={`relative flex min-w-0 flex-col items-start overflow-hidden rounded-3xl border border-line bg-surface-muted p-5 max-sm:p-4 ${className ?? ""}`}
>
	<svg
		class="pointer-events-none absolute right-3 bottom-1 w-1/3 text-ink max-sm:hidden"
		viewBox="0 0 281 164"
		fill="none"
		aria-hidden="true"
	>
		<g
			fill="none"
			stroke="currentColor"
			stroke-width="0.75"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M6.25 145.50 C9.38 144.79 19.38 144.25 25.00 141.25 C30.62 138.25 35.83 131.88 40.00 127.50 C44.17 123.12 46.25 118.25 50.00 115.00 C53.75 111.75 58.33 109.58 62.50 108.00 C66.67 106.42 71.58 105.17 75.00 105.50 C78.42 105.83 81.42 108.00 83.00 110.00 C84.58 112.00 85.33 114.79 84.50 117.50 C83.67 120.21 79.67 123.33 78.00 126.25 C76.33 129.17 74.50 132.38 74.50 135.00 C74.50 137.62 75.83 140.12 78.00 142.00 C80.17 143.88 83.83 145.67 87.50 146.25 C91.17 146.83 95.83 146.46 100.00 145.50 C104.17 144.54 108.54 142.67 112.50 140.50 C116.46 138.33 120.92 135.50 123.75 132.50 C126.58 129.50 128.67 125.83 129.50 122.50 C130.33 119.17 127.83 116.42 128.75 112.50 C129.67 108.58 132.29 102.33 135.00 99.00 C137.71 95.67 141.67 93.79 145.00 92.50 C148.33 91.21 152.17 90.71 155.00 91.25 C157.83 91.79 160.83 95.00 162.00 95.75" />
			<path d="M91.25 135.75 C93.54 135.21 101.12 134.50 105.00 132.50 C108.88 130.50 112.42 127.50 114.50 123.75 C116.58 120.00 118.25 114.58 117.50 110.00 C116.75 105.42 112.29 101.04 110.00 96.25 C107.71 91.46 105.00 85.62 103.75 81.25 C102.50 76.88 101.88 74.17 102.50 70.00 C103.12 65.83 104.58 61.04 107.50 56.25 C110.42 51.46 115.42 45.42 120.00 41.25 C124.58 37.08 130.00 33.83 135.00 31.25 C140.00 28.67 145.00 26.79 150.00 25.75 C155.00 24.71 160.62 24.08 165.00 25.00 C169.38 25.92 173.54 28.54 176.25 31.25 C178.96 33.96 180.79 36.88 181.25 41.25 C181.71 45.62 180.33 52.29 179.00 57.50 C177.67 62.71 174.12 68.33 173.25 72.50 C172.38 76.67 172.42 79.88 173.75 82.50 C175.08 85.12 178.33 87.42 181.25 88.25 C184.17 89.08 187.29 89.04 191.25 87.50 C195.21 85.96 200.21 81.38 205.00 79.00 C209.79 76.62 215.00 75.00 220.00 73.25 C225.00 71.50 230.00 70.79 235.00 68.50 C240.00 66.21 244.88 62.71 250.00 59.50 C255.12 56.29 263.12 50.96 265.75 49.25" />
			<path d="M171.75 49.25 C168.96 49.50 160.29 49.29 155.00 50.75 C149.71 52.21 144.50 54.71 140.00 58.00 C135.50 61.29 131.00 66.00 128.00 70.50 C125.00 75.00 122.83 80.08 122.00 85.00 C121.17 89.92 122.00 95.21 123.00 100.00 C124.00 104.79 126.83 110.00 128.00 113.75 C129.17 117.50 130.50 119.58 130.00 122.50 C129.50 125.42 127.71 128.54 125.00 131.25 C122.29 133.96 115.62 137.50 113.75 138.75" />
		</g>
		<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
			<path stroke-width="0.9" d="M84 24.5H100.5M92 16.5V32.5" />
			<path stroke-width="0.8" d="M42.5 54.5H56M49.3 47.5V61.5" />
			<path stroke-width="0.7" d="M49.3 51.5L53.3 54.5L49.3 57.5L45.3 54.5Z" />
			<path stroke-width="0.8" d="M62 72.5H69M65.5 68.5V76" />
		</g>
		<circle cx="211.8" cy="23.5" r="2.4" fill="currentColor" />
		<path d="M188.2 124.5L191.7 128.2L188.2 131.9L184.7 128.2Z" fill="var(--accent)" />
		<g fill="var(--faint)">
			<circle cx="42" cy="95" r="0.9" />
			<circle cx="9" cy="141.3" r="1.3" />
			<circle cx="233.7" cy="48.7" r="0.8" />
			<circle cx="213.2" cy="49.5" r="0.7" />
