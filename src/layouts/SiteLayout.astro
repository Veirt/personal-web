---
import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";
import { absoluteUrl, SITE_URL, stringifyJsonLd, type JsonLd } from "../lib/seo";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	active?: "home" | "projects" | "blog" | "now";
	type?: "website" | "article";
	noIndex?: boolean;
	socialImage?: string;
	socialImageAlt?: string;
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
	structuredData?: JsonLd | JsonLd[];
}

const {
	title,
	description,
	active,
	type = "website",
	noIndex = false,
	socialImage: socialImagePath,
	socialImageAlt: socialImageAltProp,
	publishedTime,
	modifiedTime,
	tags = [],
	structuredData,
} = Astro.props;
const site = Astro.site ?? new URL(SITE_URL);
const canonical = absoluteUrl(Astro.url.pathname, site);
const fullTitle = `${title} · veirt`;
const socialImage = absoluteUrl(socialImagePath ?? "/assets/og-image.png", site);
const socialImageAlt = socialImageAltProp ?? "A playful monochrome collage of the veirt homepage.";
const personId = `${site.href}#person`;
const websiteId = `${site.href}#website`;
const pageId = `${canonical}#webpage`;
const pageSchema: JsonLd = {
	"@type": "WebPage",
	"@id": pageId,
	url: canonical,
	name: fullTitle,
	description,
	inLanguage: "en",
	isPartOf: { "@id": websiteId },
};
const extraSchemas = structuredData
	? Array.isArray(structuredData)
		? structuredData
		: [structuredData]
	: [];
const jsonLd = noIndex
	? undefined
	: {
		"@context": "https://schema.org",
		"@graph": [
			{
				"@type": "WebSite",
				"@id": websiteId,
				url: site.href,
				name: "veirt",
				description: "A small corner of the internet for software, experiments, and notes.",
				inLanguage: "en",
				publisher: { "@id": personId },
			},
			{
				"@type": "Person",
				"@id": personId,
				name: "Veirt",
				url: site.href,
				sameAs: ["https://github.com/Veirt", "https://x.com/_veirt"],
				knowsAbout: ["Rust", "TypeScript", "DevOps", "Self-hosting", "Web development"],
			},
			pageSchema,
			...extraSchemas,
		],
		};
const links = [
	{ href: "/", label: "Home", index: "01", key: "home" },
	{ href: "/projects/", label: "Projects", index: "02", key: "projects" },
	{ href: "/blog/", label: "Notes", index: "03", key: "blog" },
	{ href: "/now/", label: "Now", index: "04", key: "now" },
] as const;
---

<!doctype html>
<html lang="en" data-theme="dark" class="min-w-80 scroll-smooth bg-paper font-sans antialiased">
	<head>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<SEO
			title={fullTitle}
			charset="UTF-8"
			description={description}
			canonical={noIndex ? null : canonical}
			noindex={noIndex}
			nofollow={noIndex}
			robotsExtras={noIndex ? undefined : "max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
			openGraph={{
				basic: { title: fullTitle, type, image: socialImage, url: canonical },
				optional: { description, locale: "en_US", siteName: "veirt" },
				image: { alt: socialImageAlt, width: 1200, height: 630, type: "image/png" },
				...(type === "article"
					? {
							article: {
								publishedTime: publishedTime?.toISOString(),
								modifiedTime: modifiedTime?.toISOString(),
								authors: [personId],
								section: "Software and notes",
								tags,
							},
						}
					: {}),
			}}
			twitter={{
				card: "summary_large_image",
				site: "@_veirt",
				creator: "@_veirt",
				title: fullTitle,
				description,
				image: socialImage,
				imageAlt: socialImageAlt,
			}}
			extend={{
				link: [
					{ rel: "icon", href: "/favicon.png", type: "image/png" },
					{ rel: "manifest", href: "/site.webmanifest" },
					{ rel: "alternate", type: "application/rss+xml", title: "veirt notes", href: "/feed.xml" },
					{ rel: "sitemap", href: "/sitemap-index.xml" },
					{ rel: "preconnect", href: "https://github.com" },
				],
				meta: [
					{ name: "author", content: "Veirt" },
					{
						name: "googlebot",
						content: noIndex
							? "noindex, nofollow"
							: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
					},
					{ name: "theme-color", content: "#111213" },
				],
			}}
		/>
		{jsonLd && <script type="application/ld+json" set:html={stringifyJsonLd(jsonLd)} />}
		<script is:inline>
			try {
				const theme = localStorage.getItem("theme");
				if (theme === "dark" || theme === "light") document.documentElement.dataset.theme = theme;
			} catch {}
		</script>
		<script>
			import "../scripts/theme";
		</script>
		<ClientRouter />
	</head>
	<body class="min-h-screen bg-paper text-base leading-relaxed text-ink">
		<a
			class="fixed top-3 left-3 z-50 -translate-y-full rounded-full bg-ink px-4 py-2 text-paper focus:translate-y-0"
			href="#main"
		>
			Skip to content
		</a>
		<header class="sticky top-0 z-30 hidden min-h-16 items-center justify-between gap-4 bg-paper/90 px-4 py-2 backdrop-blur-md max-lg:flex max-sm:min-h-14 max-sm:gap-2 max-sm:px-3">
			<a
				class="font-brand text-5xl leading-none font-bold tracking-tighter max-md:text-4xl max-sm:text-3xl"
				href="/"
				aria-label="veirt home"
			>
				veirt<span class="text-accent">.</span>
			</a>
			<nav class="flex items-center gap-4 max-sm:gap-2" aria-label="Main navigation">
				{links.map(({ href, label, key }) => (
					<a
						class="text-xs text-muted aria-[current=page]:font-bold aria-[current=page]:text-accent-strong"
						href={href}
						aria-current={active === key ? "page" : undefined}
					>
						{label}
					</a>
				))}
				<button
					class="grid size-8 place-items-center rounded-full bg-surface-muted text-accent-strong transition-colors hover:bg-surface-raised"
					data-theme-toggle
					aria-label="Switch to dark mode"
				>
					<svg class="theme-toggle__sun size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<circle cx="12" cy="12" r="3.25" stroke="currentColor" stroke-width="1.6" />
						<path
							d="M12 2.75v2.1m0 14.3v2.1M2.75 12h2.1m14.3 0h2.1M5.47 5.47l1.49 1.49m10.08 10.08 1.49 1.49m0-13.06-1.49 1.49M6.96 17.04l-1.49 1.49"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
						/>
					</svg>
					<svg class="theme-toggle__moon size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path
							d="M19.2 15.4A8 8 0 0 1 8.6 4.8 8.1 8.1 0 1 0 19.2 15.4Z"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
						<path
							d="M17.5 3.3v3m-1.5-1.5h3"
							stroke="currentColor"
							stroke-width="1.4"
							stroke-linecap="round"
						/>
					</svg>
				</button>
			</nav>
		</header>

		<aside
			class="fixed top-1/2 left-10 z-20 w-44 -translate-y-1/2 max-lg:hidden"
			aria-label="Site navigation"
		>
			<a
				class="inline-block font-brand text-5xl leading-none font-bold tracking-tighter transition-transform duration-300 hover:scale-105 hover:-rotate-3"
				href="/"
				aria-label="veirt home"
			>
				veirt<span class="text-accent">.</span>
			</a>
			<p class="mt-3 mb-10 text-xs leading-normal text-muted">
				A small corner
				<br />
				of the internet
			</p>
			<nav aria-label="Main navigation">
				<ul>
					{links.map(({ href, label, index, key }) => (
						<li>
							<a
								class="relative flex items-baseline gap-3 px-1 py-2 text-sm text-muted transition-transform before:absolute before:-left-3.5 before:size-1.5 before:scale-0 before:rounded-full before:bg-accent before:transition-transform before:content-[''] hover:translate-x-1 hover:text-ink aria-[current=page]:translate-x-1 aria-[current=page]:text-ink aria-[current=page]:before:scale-100"
								href={href}
								aria-current={active === key ? "page" : undefined}
							>
								<span class="font-mono text-xs text-faint">{index}</span>
								<span>{label}</span>
							</a>
						</li>
					))}
				</ul>
			</nav>
			<div class="mt-8">
				<button
					class="grid size-10 place-items-center rounded-full bg-surface-muted text-accent-strong transition-colors hover:bg-surface-raised"
					data-theme-toggle
					aria-label="Switch to dark mode"
				>
					<svg class="theme-toggle__sun size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<circle cx="12" cy="12" r="3.25" stroke="currentColor" stroke-width="1.6" />
						<path
							d="M12 2.75v2.1m0 14.3v2.1M2.75 12h2.1m14.3 0h2.1M5.47 5.47l1.49 1.49m10.08 10.08 1.49 1.49m0-13.06-1.49 1.49M6.96 17.04l-1.49 1.49"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
						/>
					</svg>
					<svg class="theme-toggle__moon size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path
							d="M19.2 15.4A8 8 0 0 1 8.6 4.8 8.1 8.1 0 1 0 19.2 15.4Z"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
						<path
							d="M17.5 3.3v3m-1.5-1.5h3"
							stroke="currentColor"
							stroke-width="1.4"
							stroke-linecap="round"
						/>
					</svg>
				</button>
			</div>
		</aside>

		<main
			id="main"
			class="ml-[var(--main-offset)] min-h-screen w-[min(var(--main-width),calc(100vw-var(--main-offset)-2.5rem))] pt-9 pb-4 max-lg:mx-auto max-lg:w-full max-lg:max-w-5xl max-lg:px-6 max-lg:pt-8 max-lg:pb-2 max-md:px-5 max-sm:px-3 max-sm:pt-8"
		>
			<slot />
		</main>
	</body>
</html>
